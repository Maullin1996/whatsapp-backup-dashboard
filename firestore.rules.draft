// Copia de las reglas PUBLICADAS a mano en la consola de Firebase: la versión
// del 2026-10-01 (7:37 p.m.) más el bloque de winning_numbers, PUBLICADO el
// 2026-10-02. No referenciado en firebase.json: se publica a mano pegándolo
// en la consola; esa publicación REEMPLAZA todo el conjunto de reglas. Antes
// de publicar un cambio, confirmar que las reglas de la consola siguen
// siendo las de esta copia.
//
// Bloques existentes (copia exacta de las reglas actuales de la consola, sin
// cambios): whatsapp_messages, group_stats, edit_attempts y users.
//
// Bloques nuevos (nombres PROVISIONALES):
// - Escritura (create/update) de los registros de revisión en image_reviews,
//   para Revisor/Sumador; sin delete.
// - Lectura (get/list) de los registros, solo para admin o superAdmin
//   (isAdmin()), con comodín recursivo para la consulta de grupo de
//   colecciones sobre `registros` (Resumen y Coincidencias). Revisor y
//   Sumador no leen nada de image_reviews.
// - shift_image_counts: lectura solo para admin o superAdmin; escritura
//   negada (el bot escribe con el Admin SDK, que no pasa por estas reglas).
// - winning_numbers (PUBLICADO 2026-10-02): lectura solo para admin o superAdmin
//   (Coincidencias); escritura negada (la escribirá la función puente con el
//   Admin SDK). La colección todavía no existe.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /whatsapp_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /group_stats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /edit_attempts/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── Nuevo: registros de Revisor/Sumador (PUBLICADO 2026-10-01) ──────────────────
    // Ruta que arma ImageReviewRecordModel.toUploadDocument():
    // image_reviews/{chatJid}/jornadas/{fechaJornada}_{shiftKey}/registros/{messageId}_{rol}
    // get/list de esta ruta: solo los permite la regla recursiva de lectura
    // de más abajo, para admin y superAdmin. Revisor y Sumador no leen.
    match /image_reviews/{chatJid}/jornadas/{jornadaId}/registros/{registroId} {
      allow create, update: if puedeEscribirRegistro(chatJid, jornadaId, registroId);
      allow delete: if false;
    }

    // ─── Nuevo: lectura solo para admin o superAdmin (PUBLICADO 2026-10-01) ──────────
    // Claims booleanos: `admin` puede faltar o valer false; `superAdmin` vale
    // true o no existe. Se leen con get() para que un claim ausente dé false
    // sin error.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.get('superAdmin', false) == true);
    }

    // Lectura de los registros de revisión, con comodín recursivo: es la
    // forma que exige una consulta de grupo de colecciones (rules_version 2)
    // y también cubre el get/list de image_reviews/.../registros/{id}. OJO:
    // el nombre "registros" aplica a TODA colección con ese nombre en la base,
    // a cualquier profundidad (hoy no hay otra). Solo lectura: la escritura
    // sigue siendo la del bloque de image_reviews de arriba.
    match /{path=**}/registros/{registroId} {
      allow read: if isAdmin();
    }

    // Contadores que publica el bot (lo lee el Resumen).
    match /shift_image_counts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Números ganadores del día, un documento por fecha (lo lee
    // Coincidencias). Nombre PROVISIONAL; PUBLICADO 2026-10-02.
    match /winning_numbers/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Claim reviewRole ('revisor' | 'sumador'), leído con get() para que un
    // claim ausente dé null y la regla niegue sin error.
    function reviewRole() {
      return request.auth.token.get('reviewRole', null);
    }

    // Jornadas asignables: nombres del enum Shift, nunca outOfShift.
    function shiftKeyValido(shiftKey) {
      return shiftKey in ['morning', 'afternoon1', 'afternoon2', 'night1', 'night2', 'holiday'];
    }

    // Todas las claves del payload actual, con su tipo. Sin hasOnly, para no
    // romper al agregar campos. No valida el contenido de comprobantes.
    function payloadValido(data) {
      return data.keys().hasAll([
          'messageId', 'chatJid', 'shift', 'shiftKey', 'rol', 'storagePath',
          'fechaJornada', 'messageTimestamp', 'comprobantes', 'anotaciones',
          'registradoEn', 'registradoPor', 'editado'
        ])
        && data.messageId is string
        && data.chatJid is string
        && data.shift is string
        && data.shiftKey is string
        && data.rol is string
        && data.storagePath is string
        && data.fechaJornada is string
        && data.registradoEn is string
        && data.registradoPor is string
        && data.messageTimestamp is int
        && data.comprobantes is list
        && data.comprobantes.size() >= 1
        && data.editado is bool
        && (data.anotaciones == null || data.anotaciones is string);
    }

    // Contra el mensaje real: una sola lectura de whatsapp_messages. Si el
    // mensaje no existe, get() falla y la regla niega.
    function coincideConMensaje(data) {
      let mensaje = get(/databases/$(database)/documents/whatsapp_messages/$(data.messageId)).data;
      return mensaje.messageTimestamp == data.messageTimestamp
        && mensaje.chatJid == data.chatJid;
    }

    // Orden: sesión y claim primero, la lectura del mensaje al final (&& corta).
    function puedeEscribirRegistro(chatJid, jornadaId, registroId) {
      let data = request.resource.data;
      return request.auth != null
        && reviewRole() in ['revisor', 'sumador']
        && payloadValido(data)
        && data.rol == reviewRole()
        && registroId == data.messageId + '_' + data.rol
        && chatJid == data.chatJid
        && data.fechaJornada.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && shiftKeyValido(data.shiftKey)
        && jornadaId == data.fechaJornada + '_' + data.shiftKey
        && coincideConMensaje(data);
    }
  }
}
